{
  "name": "openhexa-e2e",
  "private": true,
  "description": "End-to-end regression suite run against a deployed OpenHEXA environment.",
  "engines": {
    "node": ">= 20"
  },
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:watch": "E2E_SLOW_MO=500 playwright test --headed --workers=1",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "postinstall": "playwright install chromium",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.5.5",
    "dotenv": "^16.4.5",
    "typescript": "^5.6.2"
  }
}
