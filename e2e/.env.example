# Copy to `.env` and fill in. Never commit the filled-in file.

# Environment under test. Defaults to the demo environment.
E2E_BASE_URL=https://app.demo.openhexa.org

# Credentials of the dedicated test account for that environment.
E2E_EMAIL=
E2E_PASSWORD=

# Optional: an account with no access to the test workspace (not a member, not
# an admin or owner of the organization). Tests that need it are skipped without.
E2E_OUTSIDER_EMAIL=
E2E_OUTSIDER_PASSWORD=

# Optional: a read-only Mailgun account key, for reading the mail the app sends
# to *@E2E_MAIL_DOMAIN (a Mailgun receiving domain whose route stores every
# message). Tests that read email are skipped without it. The domain, API host
# and the account that receives pipeline run reports default to the ones set
# up for the suite.
E2E_MAILGUN_API_KEY=
# E2E_MAILGUN_API_BASE=https://api.eu.mailgun.net
# E2E_MAIL_DOMAIN=e2e-testing.openhexa.org
# E2E_RECIPIENT_EMAIL=pipeline-reports@e2e-testing.openhexa.org
# E2E_RECIPIENT_NAME=Pipeline Reports

# The organization the suite exercises, and the values it asserts on.
E2E_ORGANIZATION_ID=9c0eda6f-5450-4167-be64-e4decbf4da46
E2E_ORGANIZATION_NAME=Playwright Integration Testing
E2E_ORGANIZATION_SHORT_NAME=PIT

# A dedicated, empty workspace the feature tests create resources in.
E2E_WORKSPACE_SLUG=playwright-ws
E2E_WORKSPACE_NAME=Playwright WS
