# Copy to `.env` and fill in. Never commit the filled-in file.

# Environment under test. Defaults to the demo environment.
E2E_BASE_URL=https://app.demo.openhexa.org

# Credentials of the dedicated test account for that environment.
E2E_EMAIL=
E2E_PASSWORD=

# The organization the suite exercises, and the values it asserts on.
E2E_ORGANIZATION_ID=9c0eda6f-5450-4167-be64-e4decbf4da46
E2E_ORGANIZATION_NAME=Playwright Integration Testing
E2E_ORGANIZATION_SHORT_NAME=PIT

# A dedicated, empty workspace the feature tests create resources in.
E2E_WORKSPACE_SLUG=playwright-ws
