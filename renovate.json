{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "minimumReleaseAge": "7 days",
  "automerge": false,
  "automergeStrategy": "squash",
  "patch": {
    "automerge": true
  },
  "minor": {
    "automerge": true
  },
  "prConcurrentLimit": 5,
  "packageRules": [
    {
      "description": "pydantic-evals pins pydantic-ai-slim to its own version and pydantic-ai-slim sets a minimum genai-prices, so they only resolve when bumped together",
      "matchPackageNames": ["pydantic-ai-slim", "pydantic-evals", "genai-prices"],
      "groupName": "pydantic-ai"
    }
  ],
  "pip_requirements": {
    "enabled": false
  },
  "pip_setup": {
    "enabled": false
  },
  "pip-compile": {
    "fileMatch": ["(^|/)backend/requirements\\.txt$"],
    "lockFileMaintenance": {
      "enabled": true,
      "branchTopic": "pip-compile-refresh",
      "commitMessageAction": "Refresh pip-compile outputs"
    }
  }
}
